<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. AI Core Interface v10.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #020813;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* CRT Overlay Effect */
        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(0, 240, 255, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 100, 255, 0.03));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        /* Startup Loader */
        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.8s ease;
        }

        .loader-ring {
            width: 90px;
            height: 90px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
            animation: pulse 1.5s infinite;
        }

        /* Main HUD Container */
        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.15);
            background: rgba(4, 18, 38, 0.7);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 12px;
            gap: 10px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 6px;
            height: 35px;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        /* Workspace Grid - Responsive for Desktop & Mobile */
        .workspace {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 16px;
            position: relative;
            align-items: center;
            overflow: hidden;
        }

        @media (max-width: 768px) {
            .workspace {
                grid-template-columns: 1fr;
                grid-template-rows: auto 1fr 1fr;
                overflow-y: auto;
            }
            .hud-logo-svg {
                width: 220px !important;
                height: 220px !important;
            }
        }

        .panel-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            height: 100%;
            padding: 8px;
            border-radius: 6px;
            background: rgba(0, 240, 255, 0.01);
            transition: background 0.2s;
        }

        .panel-container.drag-over {
            background: rgba(0, 240, 255, 0.1);
            outline: 1px dashed #00f0ff;
        }

        /* Dynamic Response Panels */
        .hud-panel {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid #00f0ff;
            padding: 12px;
            border-radius: 6px;
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
            font-size: 0.85rem;
            line-height: 1.4;
            flex-shrink: 0;
            cursor: grab;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .hud-panel:active {
            cursor: grabbing;
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 10px;
            padding-bottom: 4px;
            font-size: 0.85rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-controls {
            display: flex;
            gap: 4px;
        }

        .move-btn {
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 2px 6px;
            font-size: 0.65rem;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Orbitron', sans-serif;
            transition: background 0.2s;
        }

        .move-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        /* Large Central Animated Logo */
        .hud-center-container {
            display: flex;
            justify-content: center;
            align-items: center;
            align-self: center;
            padding: 10px;
        }

        .hud-logo-svg {
            width: 320px;
            height: 320px;
            filter: drop-shadow(0 0 16px #00f0ff);
        }

        .svg-rotate-cw {
            transform-origin: center;
            animation: spin 25s linear infinite;
        }

        .svg-rotate-ccw {
            transform-origin: center;
            animation: spin-reverse 18s linear infinite;
        }

        .svg-pulse-core {
            transform-origin: center;
            animation: pulse-scale 2.5s ease-in-out infinite;
        }

        /* News & Query Formatting */
        .telemetry-item {
            border-left: 2px solid #00f0ff;
            padding-left: 8px;
            margin-bottom: 8px;
            background: rgba(0, 240, 255, 0.04);
            padding: 6px;
            border-radius: 0 4px 4px 0;
        }

        .telemetry-item a {
            color: #7df9ff;
            text-decoration: none;
            font-weight: bold;
        }

        .telemetry-item a:hover {
            text-decoration: underline;
            color: #ffffff;
        }

        /* Command Input Console */
        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 100px;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.85rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.4);
            padding: 8px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.25);
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.88rem;
            outline: none;
            border-radius: 4px;
        }

        button.action-btn {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px 16px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        button.action-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }
        @keyframes pulse-scale { 0%, 100% { transform: scale(0.95); opacity: 0.85; } 50% { transform: scale(1.05); opacity: 1; } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
