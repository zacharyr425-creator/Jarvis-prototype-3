<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Core Interface v8.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #020813;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* Scanlines Overlay */
        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), 
                        linear-gradient(90deg, rgba(0, 240, 255, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 100, 255, 0.03));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        /* Startup Screen */
        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.8s ease;
        }

        .loader-ring {
            width: 90px;
            height: 90px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
            animation: pulse 1.5s infinite;
        }

        /* Core HUD Shell */
        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.15);
            background: rgba(4, 18, 38, 0.7);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 12px;
            gap: 12px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 6px;
            height: 35px;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        /* Main Workspace Area */
        .workspace {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 16px;
            position: relative;
            align-items: center;
            overflow: hidden;
        }

        .panel-container {
            display: flex;
            flex-direction: column;
            gap: 12px;
            overflow-y: auto;
            height: 100%;
            padding: 10px;
            border-radius: 6px;
            background: rgba(0, 240, 255, 0.01);
            transition: background 0.2s, border 0.2s;
        }

        .panel-container.drag-over {
            background: rgba(0, 240, 255, 0.1);
            outline: 1px dashed #00f0ff;
        }

        /* Movable HUD Panels */
        .hud-panel {
            background: rgba(0, 240, 255, 0.08);
            border: 1px solid #00f0ff;
            padding: 12px;
            border-radius: 6px;
            box-shadow: 0 0 12px rgba(0, 240, 255, 0.25);
            font-size: 0.85rem;
            line-height: 1.4;
            flex-shrink: 0;
            cursor: grab;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .hud-panel:active {
            cursor: grabbing;
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 10px;
            padding-bottom: 4px;
            font-size: 0.85rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .panel-controls {
            display: flex;
            gap: 4px;
        }

        .move-btn {
            background: rgba(0, 240, 255, 0.2);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 2px 6px;
            font-size: 0.65rem;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Orbitron', sans-serif;
            transition: background 0.2s;
        }

        .move-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        /* ENLARGED CENTER LOGO */
        .hud-center-container {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px;
        }

        .hud-logo-svg {
            width: 320px;
            height: 320px;
            filter: drop-shadow(0 0 16px #00f0ff);
        }

        .svg-rotate-cw {
            transform-origin: center;
            animation: spin 25s linear infinite;
        }

        .svg-rotate-ccw {
            transform-origin: center;
            animation: spin-reverse 18s linear infinite;
        }

        .svg-pulse-core {
            transform-origin: center;
            animation: pulse-scale 2.5s ease-in-out infinite;
        }

        /* Input Console Area */
        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 100px;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.85rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.4);
            padding: 8px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.25);
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.88rem;
            outline: none;
            border-radius: 4px;
        }

        button.action-btn {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px 16px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        button.action-btn:hover {
            background: #00f0ff;
            color: #000;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }
        @keyframes pulse-scale { 0%, 100% { transform: scale(0.95); opacity: 0.85; } 50% { transform: scale(1.05); opacity: 1; } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING JARVIS HUD v8.0...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div id="left-zone" class="panel-container" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'left-zone')">
            </div>

            <div class="hud-center-container">
                <svg class="hud-logo-svg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                    <path d="M 25,45 L 25,25 L 45,25" stroke="#00f0ff" stroke-width="2" fill="none" opacity="0.8"/>
                    <path d="M 175,45 L 175,25 L 155,25" stroke="#00f0ff" stroke-width="2" fill="none" opacity="0.8"/>
                    <path d="M 25,155 L 25,175 L 45,175" stroke="#00f0ff" stroke-width="2" fill="none" opacity="0.8"/>
                    <path d="M 175,155 L 175,175 L 155,175" stroke="#00f0ff" stroke-width="2" fill="none" opacity="0.8"/>

                    <g class="svg-rotate-cw">
                        <circle cx="100" cy="100" r="78" stroke="#00f0ff" stroke-width="1.5" stroke-dasharray="6, 14, 28, 10" fill="none" opacity="0.85"/>
                        <circle cx="100" cy="100" r="85" stroke="#00f0ff" stroke-width="2" stroke-dasharray="2, 38" fill="none"/>
                    </g>

                    <g class="svg-rotate-ccw">
                        <circle cx="100" cy="100" r="64" stroke="#00f0ff" stroke-width="2" stroke-dasharray="18, 10, 4, 10" fill="none"/>
                        <circle cx="100" cy="100" r="56" stroke="#00f0ff" stroke-width="1" stroke-dasharray="3, 8" fill="none" opacity="0.6"/>
                    </g>

                    <g class="svg-pulse-core">
                        <polygon points="100,60 135,80 135,120 100,140 65,120 65,80" fill="rgba(0, 160, 255, 0.4)" stroke="#00f0ff" stroke-width="2.5"/>
                        <polygon points="100,68 126,83 126,117 100,132 74,117 74,83" fill="none" stroke="rgba(0, 240, 255, 0.7)" stroke-width="1"/>
                        <line x1="100" y1="90" x2="100" y2="110" stroke="#00f0ff" stroke-width="1.5"/>
                        <line x1="90" y1="100" x2="110" y2="100" stroke="#00f0ff" stroke-width="1.5"/>
                        <circle cx="100" cy="100" r="3" fill="#ffffff"/>
                    </g>
                </svg>
            </div>

            <div id="right-zone" class="panel-container" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event, 'right-zone')">
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Interface ready. Enter query below...</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Type prompt (e.g. 'build gaming pc', 'system report')..." onkeydown="if(event.key==='Enter') processInput()">
                <button class="action-btn" onclick="processInput()">SEND</button>
                <button class="action-btn" onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let availableVoices = [];

        function loadVoices() {
            if ('speechSynthesis' in window) {
                availableVoices = window.speechSynthesis.getVoices();
            }
        }
        if ('speechSynthesis' in window) {
            window.speechSynthesis.onvoiceschanged = loadVoices;
            loadVoices();
        }

        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                    speak("System fully operational, Sir. Side docks removed and logo enlarged.");
                }, 500);
            }
        }, 1200);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        function speak(text) {
            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                
                utterance.pitch = 0.70; 
                utterance.rate = 0.92;

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('George') ||
                    (v.lang.includes('en-GB') && v.name.toLowerCase().includes('male')) ||
                    v.name.includes('Daniel')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];

                if (preferredVoice) utterance.voice = preferredVoice;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;
        }

        // Moves response panel between left and right zones
        function movePanel(panelId, targetZoneId) {
            const panel = document.getElementById(panelId);
            const targetZone = document.getElementById(targetZoneId);
            if (panel && targetZone) {
                targetZone.prepend(panel);
                const isLeft = targetZoneId.includes('left');
                
                const btn = panel.querySelector('.move-btn');
                if (btn) {
                    btn.innerText = isLeft ? 'Move Right ➔' : '⬅ Move Left';
                    btn.onclick = () => movePanel(panelId, isLeft ? 'right-zone' : 'left-zone');
                }
                speak(`Relocated panel to ${isLeft ? 'left' : 'right'} side, Sir.`);
            }
        }

        // Dynamically creates movable HUD panels
        function createResponsePanel(title, contentHtml, defaultZone = 'right-zone') {
            const panelId = 'panel-' + Date.now();
            const panel = document.createElement('div');
            panel.className = 'hud-panel';
            panel.id = panelId;
            panel.draggable = true;
            panel.setAttribute('ondragstart', 'handleDragStart(event)');

            const isLeft = defaultZone.includes('left');

            panel.innerHTML = `
                <h3>
                    <span>${title}</span>
                    <div class="panel-controls">
                        <button class="move-btn" onclick="movePanel('${panelId}', '${isLeft ? 'right-zone' : 'left-zone'}')">
                            ${isLeft ? 'Move Right ➔' : '⬅ Move Left'}
                        </button>
                    </div>
                </h3>
                <div>${contentHtml}</div>
            `;

            document.getElementById(defaultZone).prepend(panel);
        }

        function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            const qLower = query.toLowerCase();

            if (qLower.startsWith('build') || qLower.startsWith('how to make')) {
                const item = query.replace(/build|how to make/gi, '').trim() || 'Project';
                const body = `
                    <p style="margin-bottom:6px;"><strong>Blueprint Sequence:</strong></p>
                    <p>1. Gather essential materials for ${item}.</p>
                    <p>2. Assemble structural housing.</p>
                    <p>3. Calibrate core systems and connectivity.</p>
                    <p>4. Execute operational tests.</p>
                `;
                createResponsePanel(`BUILD: ${item.toUpperCase()}`, body, 'right-zone');
                speak(`Generated movable blueprint for ${item}, Sir.`);
                return;
            }

            const responseText = `
                <p>• Input Directive: "<em>${query}</em>"</p>
                <p>• Data processed and rendered.</p>
                <p style="margin-top:6px;"><a href="https://www.google.com/search?q=${encodeURIComponent(query)}" target="_blank" style="color:#00f0ff;">Open Search Telemetry ➔</a></p>
            `;
            createResponsePanel(`RESPONSE: ${query.toUpperCase()}`, responseText, 'right-zone');
            speak(`Response panel created for ${query}, Sir.`);
        }

        // Drag & Drop Handling
        function handleDragStart(event) {
            event.dataTransfer.setData("text/plain", event.currentTarget.id);
        }

        function handleDragOver(event) {
            event.preventDefault();
            event.currentTarget.classList.add('drag-over');
        }

        function handleDragLeave(event) {
            event.currentTarget.classList.remove('drag-over');
        }

        function handleDrop(event, zoneId) {
            event.preventDefault();
            const targetZone = document.getElementById(zoneId);
            targetZone.classList.remove('drag-over');
            
            const panelId = event.dataTransfer.getData("text/plain");
            if (panelId) movePanel(panelId, zoneId);
        }

        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Voice synthesis is unavailable on this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-US';
            recognition.start();

            document.getElementById('log').innerText = "SYSTEM: Speech recognition listening...";

            recognition.onresult = (event) => {
                document.getElementById('userInput').value = event.results[0][0].transcript;
                processInput();
            };
        }
    </script>
</body>
</html>
