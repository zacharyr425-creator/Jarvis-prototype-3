<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>J.A.R.V.I.S. Core Interface v5.0</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Share+Tech+Mono&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        html, body {
            width: 100%;
            height: 100%;
            background-color: #030a16;
            color: #00f0ff;
            font-family: 'Share Tech Mono', monospace;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        body::before {
            content: " ";
            position: absolute;
            inset: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.04), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.04));
            z-index: 10;
            background-size: 100% 3px, 6px 100%;
            pointer-events: none;
        }

        #loader {
            position: fixed;
            inset: 0;
            background-color: #02060e;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 999;
            transition: opacity 0.8s ease;
        }

        .loader-ring {
            width: 90px;
            height: 90px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            box-shadow: 0 0 15px #00f0ff;
        }

        .loader-text {
            margin-top: 20px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.9rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
            animation: pulse 1.5s infinite;
        }

        #hud-container {
            flex: 1;
            width: 100vw;
            height: 100vh;
            border: 1px solid rgba(0, 240, 255, 0.3);
            box-shadow: inset 0 0 20px rgba(0, 240, 255, 0.15);
            background: rgba(4, 18, 38, 0.6);
            backdrop-filter: blur(5px);
            display: flex;
            flex-direction: column;
            padding: 10px;
            gap: 10px;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            padding-bottom: 5px;
            height: 35px;
        }

        .system-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 10px #00f0ff;
        }

        .workspace {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 10px;
            position: relative;
            align-items: center;
            overflow: hidden;
            transition: all 0.4s ease;
        }

        .workspace.expanded {
            grid-template-columns: 1fr;
        }

        .workspace.expanded .logo-container {
            display: none;
        }

        .hud-panel {
            background: rgba(0, 240, 255, 0.06);
            border: 1px solid #00f0ff;
            padding: 12px;
            border-radius: 6px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.15);
            height: 100%;
            overflow-y: auto;
            display: none;
            font-size: 0.85rem;
            line-height: 1.4;
            cursor: grab;
            transition: transform 0.2s ease, opacity 0.3s ease;
        }

        .hud-panel:active {
            cursor: grabbing;
        }

        .hud-panel h3 {
            font-family: 'Orbitron', sans-serif;
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);
            margin-bottom: 8px;
            padding-bottom: 4px;
            font-size: 0.9rem;
            color: #ffffff;
            text-shadow: 0 0 8px #00f0ff;
            text-transform: uppercase;
        }

        /* NEW HEXAGON LOGO DESIGN */
        .logo-container {
            display: flex;
            justify-content: center;
            align-items: center;
            grid-column: 2;
            padding: 10px;
            position: relative;
        }

        .hex-outer-ring {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.4);
            border-top: 2px solid #00f0ff;
            border-bottom: 2px solid #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            animation: spin 15s linear infinite;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }

        .hex-target-marks {
            position: absolute;
            width: 160px;
            height: 160px;
            border: 1px dashed rgba(0, 240, 255, 0.3);
            border-radius: 50%;
            animation: spin-reverse 25s linear infinite;
        }

        .hexagon-core {
            width: 70px;
            height: 80px;
            background: rgba(0, 240, 255, 0.15);
            clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
            border: 1.5px solid #00f0ff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 15px #00f0ff;
            animation: pulse 2.5s ease-in-out infinite;
        }

        .hex-crosshair {
            width: 12px;
            height: 12px;
            position: relative;
        }

        .hex-crosshair::before, .hex-crosshair::after {
            content: '';
            position: absolute;
            background: #00f0ff;
        }

        .hex-crosshair::before { top: 5px; left: 0; width: 12px; height: 2px; }
        .hex-crosshair::after { top: 0; left: 5px; width: 2px; height: 12px; }

        .hex-label {
            font-size: 0.5rem;
            letter-spacing: 1px;
            margin-top: 4px;
            color: #ffffff;
            font-family: 'Orbitron', sans-serif;
        }

        .terminal-area {
            display: flex;
            flex-direction: column;
            gap: 6px;
            height: 90px;
        }

        .log-box {
            flex: 1;
            overflow-y: auto;
            color: #7df9ff;
            font-size: 0.85rem;
            text-shadow: 0 0 5px #00f0ff;
            background: rgba(0, 0, 0, 0.3);
            padding: 6px;
            border-radius: 4px;
            border: 1px solid rgba(0, 240, 255, 0.2);
        }

        .controls {
            display: flex;
            gap: 8px;
        }

        input[type="text"] {
            flex: 1;
            background: rgba(0, 240, 255, 0.1);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.9rem;
            outline: none;
            border-radius: 4px;
        }

        button {
            background: rgba(0, 240, 255, 0.25);
            border: 1px solid #00f0ff;
            color: #00f0ff;
            padding: 10px 14px;
            cursor: pointer;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.8rem;
            border-radius: 4px;
            transition: all 0.2s;
        }

        button:active {
            background: #00f0ff;
            color: #000;
        }

        ul.calendar-list {
            list-style: none;
            padding: 0;
        }

        ul.calendar-list li {
            background: rgba(0, 240, 255, 0.08);
            margin: 4px 0;
            padding: 6px;
            border-left: 2px solid #00f0ff;
            display: flex;
            justify-content: space-between;
        }

        @keyframes spin { 100% { transform: rotate(360deg); } }
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }
        @keyframes pulse { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
    </style>
</head>
<body>

    <div id="loader">
        <div class="loader-ring"></div>
        <div class="loader-text">INITIALIZING STARK HUD v5.0...</div>
    </div>

    <div id="hud-container">
        <header>
            <div class="system-title">J.A.R.V.I.S.</div>
            <div id="clock">00:00:00</div>
        </header>

        <div id="workspace" class="workspace">
            <div id="left-panel" class="hud-panel" style="grid-column: 1;" draggable="true">
                <h3 id="left-title">SYSTEM MONITOR</h3>
                <div id="left-content">
                    <p>• Core Status: Standby</p>
                    <p>• Display State: Clean</p>
                    <p>• Voice Engine: Pitch Shifted</p>
                </div>
            </div>

            <div class="logo-container">
                <div class="hex-target-marks"></div>
                <div class="hex-outer-ring">
                    <div class="hexagon-core">
                        <div class="hex-crosshair"></div>
                        <div class="hex-label">STARK</div>
                    </div>
                </div>
            </div>

            <div id="right-panel" class="hud-panel" style="grid-column: 3;" draggable="true">
                <h3 id="right-title">CALENDAR / SCHEDULE</h3>
                <div id="right-content">
                    <ul id="calendarList" class="calendar-list">
                        <li><span>Project Review</span> <span>10:00 AM</span></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="terminal-area">
            <div id="log" class="log-box">SYSTEM: Standby mode active.</div>
            <div class="controls">
                <input type="text" id="userInput" placeholder="Ask JARVIS or type commands..." onkeydown="if(event.key==='Enter') processInput()">
                <button onclick="processInput()">SEND</button>
                <button onclick="startVoice()">MIC</button>
            </div>
        </div>
    </div>

    <script>
        let availableVoices = [];
        let currentBuildStep = 0;
        const buildGuide = [
            "Step 1: Check components and power source connection.",
            "Step 2: Connect primary data pins and initialize HUD layout.",
            "Step 3: Test audio frequency and British voice synthesis output.",
            "Step 4: Calibrate positioning engines and panel shifts."
        ];

        // Ensure clean layout on startup
        setTimeout(() => {
            const loader = document.getElementById('loader');
            if (loader) {
                loader.style.opacity = '0';
                setTimeout(() => {
                    loader.style.display = 'none';
                    speak("System online. Clean display loaded and standing by, Sir.");
                }, 500);
            }
        }, 1500);

        setInterval(() => {
            const clock = document.getElementById('clock');
            if (clock) clock.innerText = new Date().toLocaleTimeString();
        }, 1000);

        // Voice with deep British accent characteristics
        function speak(text) {
            try {
                if (!('speechSynthesis' in window)) return;
                window.speechSynthesis.cancel();
                const utterance = new SpeechSynthesisUtterance(text);
                
                // Lower pitch and slightly slower rate for a deeper, composed tone
                utterance.pitch = 0.75;
                utterance.rate = 0.9;

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();
                const preferredVoice = voices.find(v => 
                    v.name.includes('Google UK English Male') || 
                    v.name.includes('George') ||
                    v.name.includes('Oliver') ||
                    (v.lang.includes('en-GB') && v.name.includes('Male')) ||
                    v.name.includes('Daniel')
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];

                if (preferredVoice) utterance.voice = preferredVoice;
                window.speechSynthesis.speak(utterance);
            } catch (e) {}

            const log = document.getElementById('log');
            if (log) log.innerText = "JARVIS: " + text;
        }

        window.speechSynthesis.onvoiceschanged = () => {
            availableVoices = window.speechSynthesis.getVoices();
        };

        async function processInput() {
            const inputField = document.getElementById('userInput');
            if (!inputField) return;
            const query = inputField.value.trim();
            if (!query) return;

            inputField.value = '';
            const qLower = query.toLowerCase();

            // Panel Movement Logic
            if (qLower.includes('move left') || qLower.includes('shift left')) {
                shiftPanels('left');
                speak("Moving primary display to the left panel.");
                return;
            }

            if (qLower.includes('move right') || qLower.includes('shift right')) {
                shiftPanels('right');
                speak("Moving primary display to the right panel.");
                return;
            }

            if (qLower.includes('swap') || qLower.includes('switch side')) {
                swapPanels();
                speak("Swapping HUD panel positions.");
                return;
            }

            // Calendar Logic (Colander handle)
            if (qLower.includes('calendar') || qLower.includes('colander') || qLower.includes('schedule') || qLower.includes('add event')) {
                const itemText = query.replace(/add to calendar|add to colander|add event|calendar|colander/gi, '').trim();
                showPanel('right');
                if (itemText) {
                    addCalendarItem(itemText);
                    speak("Added " + itemText + " to your schedule, Sir.");
                } else {
                    speak("Displaying your active schedule.");
                }
                return;
            }

            // Building Guidance
            if (qLower.includes('build') || qLower.includes('help me build') || qLower.includes('assembly')) {
                currentBuildStep = 0;
                showPanel('left');
                const leftContent = document.getElementById('left-content');
                document.getElementById('left-title').innerText = "BUILD ASSISTANT";
                leftContent.innerHTML = "<p><strong>" + buildGuide[0] + "</strong></p>";
                speak("Build mode initialized. " + buildGuide[0]);
                return;
            }

            if (qLower.includes('next step') || qLower.includes('next instruction')) {
                if (currentBuildStep < buildGuide.length - 1) {
                    currentBuildStep++;
                    const leftContent = document.getElementById('left-content');
                    leftContent.innerHTML = "<p><strong>" + buildGuide[currentBuildStep] + "</strong></p>";
                    speak(buildGuide[currentBuildStep]);
                } else {
                    speak("Build sequence complete, Sir.");
                }
                return;
            }

            // Default Search/Handling
            speak("Processing directives for " + query + ", Sir.");
            showPanel('right');
            document.getElementById('right-title').innerText = "QUERY: " + query.toUpperCase();
            document.getElementById('right-content').innerHTML = "<p>Analyzing data logs and search feeds...</p>";
        }

        function shiftPanels(direction) {
            const left = document.getElementById('left-panel');
            const right = document.getElementById('right-panel');
            if (direction === 'left') {
                left.style.display = 'block';
                right.style.display = 'none';
            } else {
                right.style.display = 'block';
                left.style.display = 'none';
            }
        }

        function swapPanels() {
            const left = document.getElementById('left-panel');
            const right = document.getElementById('right-panel');
            const tempLeftDisplay = left.style.display;
            left.style.display = right.style.display;
            right.style.display = tempLeftDisplay;
        }

        function showPanel(panelId) {
            if (panelId === 'left') document.getElementById('left-panel').style.display = 'block';
            if (panelId === 'right') document.getElementById('right-panel').style.display = 'block';
        }

        function addCalendarItem(text) {
            const calList = document.getElementById('calendarList');
            if (!calList) return;
            const li = document.createElement('li');
            li.innerHTML = `<span>${text}</span> <span>${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>`;
            calList.appendChild(li);
        }

        function startVoice() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                alert("Speech recognition is not supported in this browser.");
                return;
            }

            const recognition = new SpeechRecognition();
            recognition.lang = 'en-GB';
            recognition.start();

            const log = document.getElementById('log');
            if (log) log.innerText = "SYSTEM: Listening...";

            recognition.onresult = (event) => {
                const transcript = event.results[0][0].transcript;
                document.getElementById('userInput').value = transcript;
                processInput();
            };

            recognition.onerror = () => {
                speak("I didn't catch that, Sir.");
            };
        }
    </script>
</body>
</html>
