<!DOCTYPE html>  
<html lang="en">  
<head>  
    <meta charset="UTF-8">  
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">  
    <title>J.A.R.V.I.S. Core Interface v5.0</title>  
    <style>  
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&display=swap');  

        * {  
            box-sizing: border-box;  
            margin: 0;  
            padding: 0;  
            user-select: none;  
        }  

        html, body {  
            width: 100%;  
            height: 100%;  
            background-color: #02060e;  
            color: #00f0ff;  
            font-family: 'Share Tech Mono', monospace;  
            overflow: hidden;  
            display: flex;  
            flex-direction: column;  
        }  

        /* CRT Overlay Filter */
        body::before {  
            content: " ";  
            position: absolute;  
            inset: 0;  
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.35) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));  
            z-index: 10;  
            background-size: 100% 3px, 6px 100%;  
            pointer-events: none;  
        }  

        #loader {  
            position: fixed;  
            inset: 0;  
            background-color: #02060e;  
            display: flex;  
            flex-direction: column;  
            justify-content: center;  
            align-items: center;  
            z-index: 999;  
            transition: opacity 0.8s ease;  
        }  

        .loader-ring {  
            width: 100px;  
            height: 100px;  
            border: 3px solid transparent;  
            border-top: 3px solid #00f0ff;  
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;  
            animation: spin 1s linear infinite;  
            box-shadow: 0 0 20px #00f0ff;  
        }  

        .loader-text {  
            margin-top: 25px;  
            font-family: 'Orbitron', sans-serif;  
            font-size: 0.9rem;  
            letter-spacing: 3px;  
            color: #00f0ff;
            text-shadow: 0 0 10px #00f0ff;  
            animation: pulse 1.5s infinite;  
        }  

        #hud-container {  
            flex: 1;  
            width: 100vw;  
            height: 100vh;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            box-shadow: inset 0 0 30px rgba(0, 240, 255, 0.1);  
            background: radial-gradient(circle at center, rgba(4, 20, 45, 0.8) 0%, rgba(2, 6, 14, 0.95) 100%);  
            display: flex;  
            flex-direction: column;  
            padding: 15px;  
            gap: 12px;  
        }  

        header {  
            display: flex;  
            justify-content: space-between;  
            align-items: center;  
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            padding-bottom: 8px;  
            height: 40px;  
        }  

        .system-title {  
            font-family: 'Orbitron', sans-serif;  
            font-weight: 900;
            font-size: 1.2rem;  
            letter-spacing: 3px;  
            text-shadow: 0 0 12px #00f0ff;  
        }  

        #clock {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.1rem;
            letter-spacing: 2px;
            text-shadow: 0 0 8px #00f0ff;
        }

        .workspace {  
            flex: 1;  
            display: grid;  
            grid-template-columns: 280px 1fr 280px;  
            gap: 15px;  
            position: relative;  
            align-items: center;  
            overflow: hidden;  
        }  

        .hud-panel {  
            background: rgba(0, 240, 255, 0.04);  
            border: 1px solid rgba(0, 240, 255, 0.6);  
            padding: 15px;  
            border-radius: 8px;  
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.1), inset 0 0 15px rgba(0, 240, 255, 0.05);  
            height: 100%;  
            overflow-y: auto;  
            display: block;  
            font-size: 0.85rem;  
            line-height: 1.5;  
            transition: all 0.3s ease;  
        }  

        .hud-panel h3 {  
            font-family: 'Orbitron', sans-serif;  
            border-bottom: 1px solid rgba(0, 240, 255, 0.4);  
            margin-bottom: 12px;  
            padding-bottom: 6px;  
            font-size: 0.95rem;  
            color: #ffffff;  
            text-shadow: 0 0 8px #00f0ff;  
            text-transform: uppercase;  
            letter-spacing: 1px;
        }  

        /* ARC REACTOR LOGO DESIGN */  
        .logo-container {  
            display: flex;  
            justify-content: center;  
            align-items: center;  
            grid-column: 2;  
            position: relative;  
            height: 100%;
        }  

        .arc-reactor {
            position: relative;
            width: 220px;
            height: 220px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .arc-outer-ring {
            position: absolute;
            inset: 0;
            border: 2px dashed rgba(0, 240, 255, 0.5);
            border-radius: 50%;
            animation: spin 20s linear infinite;
        }

        .arc-segment-ring {
            position: absolute;
            inset: 12px;
            border: 3px solid transparent;
            border-top: 3px solid #00f0ff;
            border-bottom: 3px solid #00f0ff;
            border-radius: 50%;
            animation: spin-reverse 10s linear infinite;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.4);
        }

        .arc-inner-housing {
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 2px solid rgba(0, 240, 255, 0.8);
            background: rgba(0, 240, 255, 0.05);
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }

        .arc-coils {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: repeating-conic-gradient(
                from 0deg,
                #00f0ff 0deg 15deg,
                transparent 15deg 36deg
            );
            opacity: 0.85;
            mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            -webkit-mask-image: radial-gradient(circle, transparent 52%, black 53%, black 70%, transparent 71%);
            filter: drop-shadow(0 0 8px #00f0ff);
        }

        .arc-core-glow {
            width: 65px;
            height: 65px;
            background: #ffffff;
            border-radius: 50%;
            box-shadow: 
                0 0 20px #00f0ff,
                0 0 40px #00f0ff,
                0 0 60px #00f0ff;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: pulse 2s infinite ease-in-out;
        }

        .arc-center-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.65rem;
            font-weight: 900;
            color: #02060e;
            letter-spacing: 1.5px;
        }

        .terminal-area {  
            display: flex;  
            flex-direction: column;  
            gap: 8px;  
            height: 110px;  
        }  

        .log-box {  
            flex: 1;  
            overflow-y: auto;  
            color: #7df9ff;  
            font-size: 0.85rem;  
            text-shadow: 0 0 5px #00f0ff;  
            background: rgba(0, 0, 0, 0.5);  
            padding: 8px 12px;  
            border-radius: 4px;  
            border: 1px solid rgba(0, 240, 255, 0.3);  
            display: flex;
            align-items: center;
        }  

        .controls {  
            display: flex;  
            gap: 10px;  
        }  

        input[type="text"] {  
            flex: 1;  
            background: rgba(0, 240, 255, 0.08);  
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 14px;  
            font-family: 'Share Tech Mono', monospace;  
            font-size: 0.95rem;  
            outline: none;  
            border-radius: 4px;  
            box-shadow: inset 0 0 10px rgba(0, 240, 255, 0.1);
        }  

        input[type="text"]::placeholder {
            color: rgba(0, 240, 255, 0.5);
        }

        button {  
            background: rgba(0, 240, 255, 0.2);  
            border: 1px solid #00f0ff;  
            color: #00f0ff;  
            padding: 10px 18px;  
            cursor: pointer;  
            font-family: 'Orbitron', sans-serif;  
            font-weight: bold;
            font-size: 0.8rem;  
            border-radius: 4px;  
            transition: all 0.2s;  
            letter-spacing: 1px;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.2);
        }  

        button:hover {
            background: rgba(0, 240, 255, 0.4);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.6);
        }

        button:active {  
            background: #00f0ff;  
            color: #000;  
        }  

        ul.calendar-list {  
            list-style: none;  
            padding: 0;  
        }  

        ul.calendar-list li {  
            background: rgba(0, 240, 255, 0.08);  
            margin: 6px 0;  
            padding: 8px;  
            border-left: 3px solid #00f0ff;  
            display: flex;  
            justify-content: space-between;  
            font-size: 0.8rem;
        }  

        @keyframes spin { 100% { transform: rotate(360deg); } }  
        @keyframes spin-reverse { 100% { transform: rotate(-360deg); } }  
        @keyframes pulse { 0%, 100% { opacity: 0.7; transform: scale(0.98); } 50% { opacity: 1; transform: scale(1.02); } }  
    </style>  
</head>  
<body>  

    <div id="loader">  
        <div class="loader-ring"></div>  
        <div class="loader-text">INITIALIZING STARK HUD v5.0...</div>  
    </div>  

    <div id="hud-container">  
        <header>  
            <div class="system-title">J.A.R.V.I.S.</div>  
            <div id="clock">00:00:00</div>  
        </header>  

        <div id="workspace" class="workspace">  
            <div id="left-panel" class="hud-panel">  
                <h3 id="left-title">SYSTEM MONITOR</h3>  
                <div id="left-content">  
                    <p>• Core Status: Online</p>  
                    <p>• Web Query Engine: Active</p>  
                    <p>• Voice Engine: Ready</p>  
                    <p>• Security Protocol: Level 10</p>
                </div>  
            </div>  

            <div class="logo-container">  
                <div class="arc-reactor">
                    <div class="arc-outer-ring"></div>
                    <div class="arc-segment-ring"></div>
                    <div class="arc-inner-housing">
                        <div class="arc-coils"></div>
                        <div class="arc-core-glow">
                            <span class="arc-center-label">STARK</span>
                        </div>
                    </div>
                </div>
            </div>  

            <div id="right-panel" class="hud-panel">  
                <h3 id="right-title">CALENDAR / SCHEDULE</h3>  
                <div id="right-content">  
                    <ul id="calendarList" class="calendar-list">  
                        <li><span>Project Review</span> <span>10:00 AM</span></li>  
                    </ul>  
                </div>  
            </div>  
        </div>  

        <div class="terminal-area">  
            <div id="log" class="log-box">SYSTEM: Standby mode active. All systems operational.</div>  
            <div class="controls">  
                <input type="text" id="userInput" placeholder="Ask JARVIS or type commands..." onkeydown="if(event.key==='Enter') processInput()">  
                <button onclick="processInput()">SEND</button>  
                <button onclick="startVoice()">MIC</button>  
            </div>  
        </div>  
    </div>  

    <script>  
        let availableVoices = [];  
        let currentBuildStep = 0;  
        const buildGuide = [  
            "Step 1: Check components and power source connection.",  
            "Step 2: Connect primary data pins and initialize HUD layout.",  
            "Step 3: Test audio frequency and British voice synthesis output.",  
            "Step 4: Calibrate positioning engines and panel shifts."  
        ];  

        setTimeout(() => {  
            const loader = document.getElementById('loader');  
            if (loader) {  
                loader.style.opacity = '0';  
                setTimeout(() => {  
                    loader.style.display = 'none';  
                    speak("System online. Clean display loaded and standing by, Sir.");  
                }, 800);  
            }  
        }, 1500);  

        setInterval(() => {  
            const clock = document.getElementById('clock');  
            if (clock) clock.innerText = new Date().toLocaleTimeString();  
        }, 1000);  

        function speak(text) {  
            try {  
                if (!('speechSynthesis' in window)) return;  
                window.speechSynthesis.cancel();  
                const utterance = new SpeechSynthesisUtterance(text);  
                  
                utterance.pitch = 0.8;  
                utterance.rate = 0.95;  

                const voices = availableVoices.length ? availableVoices : window.speechSynthesis.getVoices();  
                const preferredVoice = voices.find(v =>   
                    v.name.includes('Google UK English Male') ||   
                    v.name.includes('George') ||  
                    v.name.includes('Oliver') ||  
                    (v.lang.includes('en-GB') && v.name.includes('Male')) ||  
                    v.name.includes('Daniel')  
                ) || voices.find(v => v.lang.includes('en-GB')) || voices[0];  

                if (preferredVoice) utterance.voice = preferredVoice;  
                window.speechSynthesis.speak(utterance);  
            } catch (e) {}  

            const log = document.getElementById('log');  
            if (log) log.innerText = "JARVIS: " + text;  
        }  

        window.speechSynthesis.onvoiceschanged = () => {  
            availableVoices = window.speechSynthesis.getVoices();  
        };  

        async function processInput() {  
            const inputField = document.getElementById('userInput');  
            if (!inputField) return;  
            const query = inputField.value.trim();  
            if (!query) return;  

            inputField.value = '';  
            const qLower = query.toLowerCase();  

            if (qLower.includes('move left') || qLower.includes('shift left')) {  
                shiftPanels('left');  
                speak("Moving primary display to the left panel.");  
                return;  
            }  

            if (qLower.includes('move right') || qLower.includes('shift right')) {  
                shiftPanels('right');  
                speak("Moving primary display to the right panel.");  
                return;  
            }  

            if (qLower.includes('swap') || qLower.includes('switch side')) {  
                swapPanels();  
                speak("Swapping HUD panel positions.");  
                return;  
            }  

            if (qLower.includes('calendar') || qLower.includes('colander') || qLower.includes('schedule') || qLower.includes('add event')) {  
                const itemText = query.replace(/add to calendar|add to colander|add event|calendar|colander/gi, '').trim();  
                showPanel('right');  
                if (itemText) {  
                    addCalendarItem(itemText);  
                    speak("Added " + itemText + " to your schedule, Sir.");  
                } else {  
                    speak("Displaying your active schedule.");  
                }  
                return;  
            }  

            if (qLower.includes('build') || qLower.includes('help me build') || qLower.includes('assembly')) {  
                currentBuildStep = 0;  
                showPanel('left');  
                const leftContent = document.getElementById('left-content');  
                document.getElementById('left-title').innerText = "BUILD ASSISTANT";  
                leftContent.innerHTML = "<p><strong>" + buildGuide[0] + "</strong></p>";  
                speak("Build mode initialized. " + buildGuide[0]);  
                return;  
            }  

            if (qLower.includes('next step') || qLower.includes('next instruction')) {  
                if (currentBuildStep < buildGuide.length - 1) {  
                    currentBuildStep++;  
                    const leftContent = document.getElementById('left-content');  
                    leftContent.innerHTML = "<p><strong>" + buildGuide[currentBuildStep] + "</strong></p>";  
                    speak(buildGuide[currentBuildStep]);  
                } else {  
                    speak("Build sequence complete, Sir.");  
                }  
                return;  
            }  

            // LIVE WEB DATA FETCHING  
            speak("Accessing data network for " + query + ", Sir.");  
            showPanel('right');  
            document.getElementById('right-title').innerText = "DATA: " + query.toUpperCase();  
            document.getElementById('right-content').innerHTML = "<p>Retrieving external telemetry...</p>";  

            try {  
                const wikiUrl = `https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(query)}`;  
                const response = await fetch(wikiUrl);  
                
                if (response.ok) {  
                    const data = await response.json();  
                    if (data.extract) {  
                        document.getElementById('right-content').innerHTML = `<p>${data.extract}</p>`;  
                        const shortSummary = data.extract.split('.')[0] + '.';  
                        speak(shortSummary);  
                        return;  
                    }  
                }  

                document.getElementById('right-content').innerHTML = `<p>No direct database records found for "${query}".</p>`;  
                speak("No detailed entries found in the database, Sir.");  
            } catch (error) {  
                document.getElementById('right-content').innerHTML = "<p>Data stream error. Connection interrupted.</p>";  
                speak("I encountered an error retrieving that data, Sir.");  
            }  
        }  

        function shiftPanels(direction) {  
            const left = document.getElementById('left-panel');  
            const right = document.getElementById('right-panel');  
            if (direction === 'left') {  
                left.style.display = 'block';  
                right.style.display = 'none';  
            } else {  
                right.style.display = 'block';  
                left.style.display = 'none';  
            }  
        }  

        function swapPanels() {  
            const left = document.getElementById('left-panel');  
            const right = document.getElementById('right-panel');  
            const tempLeftDisplay = left.style.display;  
            left.style.display = right.style.display;  
            right.style.display = tempLeftDisplay;  
        }  

        function showPanel(panelId) {  
            if (panelId === 'left') document.getElementById('left-panel').style.display = 'block';  
            if (panelId === 'right') document.getElementById('right-panel').style.display = 'block';  
        }  

        function addCalendarItem(text) {  
            const calList = document.getElementById('calendarList');  
            if (!calList) return;  
            const li = document.createElement('li');  
            li.innerHTML = `<span>${text}</span> <span>${new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>`;  
            calList.appendChild(li);  
        }  

        function startVoice() {  
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;  
            if (!SpeechRecognition) {  
                alert("Speech recognition is not supported in this browser.");  
                return;  
            }  

            const recognition = new SpeechRecognition();  
            recognition.lang = 'en-GB';  
            recognition.start();  

            const log = document.getElementById('log');  
            if (log) log.innerText = "SYSTEM: Listening...";  

            recognition.onresult = (event) => {  
                const transcript = event.results[0][0].transcript;  
                document.getElementById('userInput').value = transcript;  
                processInput();  
            };  

            recognition.onerror = () => {  
                speak("I didn't catch that, Sir.");  
            };  
        }  
    </script>  
</body>  
</html>
